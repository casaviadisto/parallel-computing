# Етап 1: збірка через Node + Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Копіюємо package.json та lock-файл
COPY frontend/package*.json ./

# Встановлюємо залежності
RUN npm ci

# Копіюємо решту вихідного коду фронтенду
COPY frontend/ .

# Запускаємо збірку (створить папку dist)
RUN npm run build

# Етап 2: веб-сервер Nginx
FROM nginx:alpine

# Видаляємо дефолтну конфігурацію
RUN rm /etc/nginx/conf.d/default.conf

# Копіюємо нашу конфігурацію nginx
COPY frontend/nginx.conf /etc/nginx/conf.d/

# Копіюємо зібрані статичні файли з першого етапу
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]